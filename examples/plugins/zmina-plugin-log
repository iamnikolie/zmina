#!/bin/sh
# zmina-plugin-log: the smallest plugin. It appends each event zmina tells it, one JSON line, to a file, and exits 0
# (taken). Copy it to <crew dir>/plugins/log, chmod 755 it, and add "- {name: log}" under plugins: in the crew file.
#
#   ZMINA_PLUGIN_LOG   the file to append to (default: plugin.log beside the crew file)
#
# zmina gives the event on stdin (one line) and ZMINA_PLUGIN, ZMINA_PLUGIN_EVENT and ZMINA_CREW in the environment.
# What a plugin reads is data written by roles and the owner: this one never runs or evaluates any of it.

log=${ZMINA_PLUGIN_LOG:-$(dirname "${ZMINA_CREW:-.}")/plugin.log}

IFS= read -r line || [ -n "$line" ] || exit 1
printf '%s\n' "$line" >> "$log" || exit 1
